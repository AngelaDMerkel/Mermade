  "license": "CC-BY-NC-SA-4.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "patch:mermaid": "node scripts/patch-mermaid-block-renderer.mjs",
    "dev": "npm run patch:mermaid && next dev",
    "build": "npm run patch:mermaid && next build",
    "build:pages": "npm run patch:mermaid && GITHUB_ACTIONS=true next build",
    "start": "next start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@mermaid-js/layout-elk": "^0.2.2",
    "@mermaid-js/layout-tidy-tree": "^0.2.2",
    "@mermaid-js/mermaid-zenuml": "^0.2.3",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.16.0",
    "mermaid-v10": "npm:mermaid@10.9.6",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright-core": "^1.57.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
