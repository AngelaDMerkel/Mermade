{
  "name": "mermade-visual-editor",
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "patch:mermaid": "node scripts/patch-mermaid-block-renderer.mjs",
    "dev": "npm run patch:mermaid && next dev",
    "build": "npm run patch:mermaid && next build",
    "build:pages": "npm run patch:mermaid && GITHUB_ACTIONS=true next build",
    "start": "next start",
    "test": "MERMADE_TEST_BUILD=true npm run build && MERMADE_TEST_BUILD=true node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .next-test"
  },
  "dependencies": {
    "@mermaid-js/layout-elk": "^0.2.2",
    "@mermaid-js/layout-tidy-tree": "^0.2.2",
    "@mermaid-js/mermaid-zenuml": "^0.2.3",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.16.0",
    "mermaid-v10": "npm:mermaid@10.9.6",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "playwright-core": "^1.57.0",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  },
  "type": "module"
}
